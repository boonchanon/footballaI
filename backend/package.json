{
  "name": "bundesliga-clubs-display-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express backend for football frontend with MySQL, Prisma, and AllSportsAPI",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.11.1",
    "axios": "^1.6.1",
    "axios-retry": "^4.5.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.0",
    "node-cron": "^3.0.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^5.11.1"
  },
  "prisma": {
    "schema": "./src/prisma/schema.prisma"
  }
}
